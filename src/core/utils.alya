## JSON Utility Functions.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## Checks if character is an ASCII decimal digit.
pub function json_is_digit(ch: string) -> int
    let c = ord(ch)
    return c >= 48 and c <= 57
end

## Checks if character is an ASCII whitespace character.
pub function json_is_whitespace(ch: string) -> int
    return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
end

## Advances the position reference past any leading whitespace characters.
pub function json_skip_ws(s: string, pos: array, slen: int)
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
            pos[0] += 1
        else
            break
        end
    end
end

## Converts a hexadecimal ASCII character into its integer value (0-15).
pub function json_hex_val(ch: string) -> int
    let c = ord(ch)
    when c
        is 48..=57 then return c - 48
        is 65..=70 then return c - 55
        is 97..=102 then return c - 87
        else return 0
    end
end

## Escapes special control characters in string for JSON wire encoding.
pub function json_escape_str(s: string) -> string
    let slen = len(s)
    let res = ""
    let i = 0
    let ch = ""
    let c = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        when c
            is 34 then res += "\\\""
            is 92 then res += "\\\\"
            is 10 then res += "\\n"
            is 13 then res += "\\r"
            is 9  then res += "\\t"
            is 8  then res += "\\b"
            is 12 then res += "\\f"
            else res += ch
        end
        i += 1
    end
    return res
end

## Encodes a Unicode codepoint as UTF-8.
##
## chr() only covers 0..255 and crashes the host process above that;
## this helper keeps \u decoding total without touching the compiler.
## Out-of-range codes yield "".
pub function json_chr_utf8(code: int) -> string
    if code < 0
        return ""
    end
    if code < 128
        return chr(code)
    end
    if code < 2048
        return chr(192 + code / 64) + chr(128 + code % 64)
    end
    if code < 65536
        return chr(224 + code / 4096) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)
    end
    if code < 1114112
        return chr(240 + code / 262144) + chr(128 + (code / 4096) % 64) + chr(128 + (code / 64) % 64) + chr(128 + code % 64)
    end
    return ""
end

## Unescapes JSON escape sequences into raw string characters.
pub function json_unescape_str(s: string) -> string
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == "\\" and i + 1 < slen
            let esc = char_at(s, i + 1)
            when esc
                is "\"" then
                    res += "\""
                    i += 2
                is "\\" then
                    res += "\\"
                    i += 2
                is "/" then
                    res += "/"
                    i += 2
                is "n" then
                    res += "\n"
                    i += 2
                is "r" then
                    res += "\r"
                    i += 2
                is "t" then
                    res += "\t"
                    i += 2
                is "b" then
                    res += chr(8)
                    i += 2
                is "f" then
                    res += chr(12)
                    i += 2
                is "u" then
                    if i + 5 < slen
                        let h0 = json_hex_val(char_at(s, i + 2))
                        let h1 = json_hex_val(char_at(s, i + 3))
                        let h2 = json_hex_val(char_at(s, i + 4))
                        let h3 = json_hex_val(char_at(s, i + 5))
                        let ucode = h0 * 4096 + h1 * 256 + h2 * 16 + h3
                        if ucode >= 55296 and ucode <= 56319 and i + 11 < slen and char_at(s, i + 6) == "\\" and char_at(s, i + 7) == "u"
                            let l0 = json_hex_val(char_at(s, i + 8))
                            let l1 = json_hex_val(char_at(s, i + 9))
                            let l2 = json_hex_val(char_at(s, i + 10))
                            let l3 = json_hex_val(char_at(s, i + 11))
                            let lo = l0 * 4096 + l1 * 256 + l2 * 16 + l3
                            if lo >= 56320 and lo <= 57343
                                ucode = 65536 + (ucode - 55296) * 1024 + (lo - 56320)
                                i += 6
                            else
                                ucode = 65533
                            end
                        elif (ucode >= 55296 and ucode <= 56319) or (ucode >= 56320 and ucode <= 57343)
                            ucode = 65533
                        end
                        res += json_chr_utf8(ucode)
                        i += 6
                    else
                        res += "\\u"
                        i += 2
                    end
                else
                    res += esc
                    i += 2
            end
        else
            res += ch
            i += 1
        end
    end
    return res
end

## Trims leading and trailing ASCII whitespace from a string.
pub function json_trim(s: string) -> string
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start = 0
    while start < slen and json_is_whitespace(char_at(s, start))
        start += 1
    end
    if start == slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx > start and json_is_whitespace(char_at(s, end_idx))
        end_idx -= 1
    end
    return s[start..end_idx + 1]
end
