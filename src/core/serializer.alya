## # json/serializer
##
## JSON value serializer and formatter.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./utils.alya"

## Escapes control characters in a string for JSON wire representation.
pub function json_escape(s: string) -> string
    return json_escape_str(s)
end

## Wraps a string in double quotes with JSON escaping.
pub function json_string(s: string) -> string
    let esc = json_escape(s)
    return f"\"{esc}\""
end

## Formats a numeric value without quotes.
pub function json_number(n) -> string
    return str(n)
end

## Formats an integer value without quotes.
pub function json_int(n: int) -> string
    return str(n)
end

## Formats a float value with up to 6 significant fraction digits.
pub function json_float(n) -> string
    let flt = float(n)
    let iv = int(flt)
    let fv = flt - float(iv)
    if fv < 0.0
        fv = -fv
    end
    let frac = int(fv * 1000000.0 + 0.5)
    if frac == 0
        return f"{iv}.0"
    end
    while frac % 10 == 0
        frac /= 10
    end
    return f"{iv}.{frac}"
end

## Returns the JSON null literal.
pub function json_null() -> string
    return "null"
end

## Formats a boolean flag as true or false.
pub function json_bool(b) -> string
    return when b
        is true => "true"
        else => "false"
    end
end

## Formats one quoted key and raw value pair.
pub function json_kv(key: string, val) -> string
    let ek = json_escape(key)
    let val_str = str(val)
    return f"\"{ek}\": {val_str}"
end

## Formats an array with raw element values.
pub function json_array(items: array) -> string
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    for i, item in items
        if i > 0
            res += ", "
        end
        let item_str = str(item)
        res += item_str
    end
    res += "]"
    return res
end

## Formats a quoted string array.
pub function json_array_of_strings(items: array) -> string
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    for i, item in items
        if i > 0
            res += ", "
        end
        res += json_string(item)
    end
    res += "]"
    return res
end

## Formats a numeric array.
pub function json_array_of_numbers(items: array) -> string
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    for i, item in items
        if i > 0
            res += ", "
        end
        let num_str = str(item)
        res += num_str
    end
    res += "]"
    return res
end

## Formats a boolean array.
pub function json_array_of_bools(items: array) -> string
    let count = len(items)
    if count == 0
        return "[]"
    end
    let res = "["
    for i, item in items
        if i > 0
            res += ", "
        end
        res += json_bool(item)
    end
    res += "]"
    return res
end

## Formats a map into a JSON object with raw values.
pub function json_object(m) -> string
    let k = keys(m)
    let count = len(k)
    if count == 0
        return "{}"
    end
    let res = "{"
    let i = 0
    for key, val in m
        if i > 0
            res += ", "
        end
        let ek = json_escape(key)
        let val_str = str(val)
        res += f"\"{ek}\": {val_str}"
        i += 1
    end
    res += "}"
    return res
end

## Alias for json_object.
pub function json_map(m) -> string
    return json_object(m)
end

## Checks whether a value is a list object.
##
## Shared helper (not inlined per caller) so the compiler cannot fold the
## `is array` check to a constant when callers pass different static kinds
## (see alya-lang/alya#70).
##
## ### Returns
## `1` for arrays, `0` otherwise.
pub function json_is_list(v) -> bool
    if v is array
        return true
    end
    return false
end

## Checks whether a value is a map object.
##
## Shared helper (see `json_is_list` for why this must stay a call).
##
## ### Returns
## `1` for maps, `0` otherwise.
pub function json_is_map(v) -> bool
    if v is map
        return true
    end
    return false
end

# Address-range heap probe without header dereference (mirrors Lib/yaml
# `is_heap_pointer`). Strings, arrays, and maps live on the heap while
# ints, floats, and bools are immediates, so this separates leaf scalars
# from heap values without risking the header-read fault noted in the
# language spec (Ch.02 decidability matrix).
function _json_is_heap(v) -> bool
    if v is null or v == 0
        return false
    end
    if v < 65536
        return false
    end
    if v > 140737488355327
        return false
    end
    return true
end

## Recursively encodes any native value into compact JSON.
##
## Maps and arrays nest to any depth (acyclic values only); strings are
## quoted and escaped; `null` renders as `null`; numbers render bare.
## Booleans share the int encoding, so `true`/`false` render as `1`/`0`.
pub function json_encode(val) -> string
    if val is null
        return "null"
    end
    if json_is_list(val) == true
        let res = "["
        let i = 0
        for item in val
            if i > 0
                res += ", "
            end
            res += json_encode(item)
            i += 1
        end
        res += "]"
        return res
    end
    if json_is_map(val) == true
        let res = "{"
        let first = true
        for key, item in val
            if first == false
                res += ", "
            else
                first = false
            end
            res += f"\"{json_escape(key)}\": {json_encode(item)}"
        end
        res += "}"
        return res
    end
    if _json_is_heap(val) == true
        return json_string(str(val))
    end
    return str(val)
end

## Formats a map with all values quoted as strings.
pub function json_string_map(m) -> string
    let k = keys(m)
    let count = len(k)
    if count == 0
        return "{}"
    end
    let res = "{"
    let i = 0
    for key, val in m
        if i > 0
            res += ", "
        end
        let ek = json_escape(key)
        let ev = json_escape(val)
        res += f"\"{ek}\": \"{ev}\""
        i += 1
    end
    res += "}"
    return res
end

## Strips insignificant whitespace from a JSON string.
pub function json_minify(s: string) -> string
    let slen = len(s)
    let res = ""
    let in_string = false
    let escape_next = false
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if escape_next
            res += ch
            escape_next = false
        else
            if ch == "\\" and in_string
                res += ch
                escape_next = true
            elif ch == "\""
                in_string = 1 - in_string
                res += ch
            else
                if in_string
                    res += ch
                else
                    if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
                        res += ch
                    end
                end
            end
        end
        i += 1
    end
    return res
end

## Pretty-prints a JSON string with indentation.
pub function json_pretty(s: string, indent_spaces: int = 2) -> string
    let slen = len(s)
    if slen == 0
        return ""
    end
    let pad = ""
    let p = 0
    while p < indent_spaces
        pad += " "
        p += 1
    end
    let res = ""
    let indent_level = 0
    let in_string = false
    let escape_next = false
    let i = 0
    let k = 0
    let ch = ""
    while i < slen
        ch = char_at(s, i)
        if escape_next
            res += ch
            escape_next = false
        else
            if ch == "\\" and in_string
                res += ch
                escape_next = true
            elif ch == "\""
                in_string = 1 - in_string
                res += ch
            else
                if in_string
                    res += ch
                else
                    when ch
                        is "{", "[" then
                            res += ch + "\n"
                            indent_level += 1
                            k = 0
                            while k < indent_level
                                res += pad
                                k += 1
                            end
                        is "}", "]" then
                            res += "\n"
                            indent_level -= 1
                            k = 0
                            while k < indent_level
                                res += pad
                                k += 1
                            end
                            res += ch
                        is "," then
                            res += ",\n"
                            k = 0
                            while k < indent_level
                                res += pad
                                k += 1
                            end
                        is ":" then
                            res += ": "
                        else
                            if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
                                res += ch
                            end
                    end
                end
            end
        end
        i += 1
    end
    return res
end

## Converts an arbitrary value to its compact JSON form.
## Maps and arrays are encoded recursively; strings are quoted and
## escaped; `null` renders as `null`; numbers render bare. Acyclic
## values only. Booleans share the int encoding and render as `1`/`0`.
pub function json_stringify(val) -> string
    return json_encode(val)
end
