## # json/jsonpath
##
## JSONPath and RFC 6901 JSON Pointer evaluator.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

function _jsonpath_is_int(token)
    let tlen = len(token)
    if tlen == 0
        return false
    end
    let i = 0
    if char_at(token, 0) == "-"
        if tlen == 1
            return false
        end
        i = 1
    end
    while i < tlen
        let c = ord(char_at(token, i))
        if c < 48 or c > 57
            return false
        end
        i += 1
    end
    return true
end

function _jsonpath_split(path)
    let plen = len(path)
    let tokens = []
    let i = 0
    let cur = ""
    while i < plen
        let ch = char_at(path, i)
        if ch == "."
            if len(cur) > 0
                tokens.push(cur)
                cur = ""
            end
            i += 1
        elif ch == "["
            if len(cur) > 0
                tokens.push(cur)
                cur = ""
            end
            i += 1
            let in_bracket = ""
            while i < plen and char_at(path, i) != "]"
                let bch = char_at(path, i)
                if bch != "\"" and bch != "'"
                    in_bracket += bch
                end
                i += 1
            end
            if i < plen and char_at(path, i) == "]"
                i += 1
            end
            if len(in_bracket) > 0
                tokens.push(in_bracket)
            end
        else
            cur += ch
            i += 1
        end
    end
    if len(cur) > 0
        tokens.push(cur)
    end
    return tokens
end

function _json_pointer_unescape(token)
    let tlen = len(token)
    let res = ""
    let i = 0
    while i < tlen
        let ch = char_at(token, i)
        if ch == "~" and i + 1 < tlen
            let next_ch = char_at(token, i + 1)
            when next_ch
                is "0" then res += "~"
                is "1" then res += "/"
                else res += "~" + next_ch
            end
            i += 2
        else
            res += char_at(token, i)
            i += 1
        end
    end
    return res
end

## Resolves a value using RFC 6901 JSON Pointer syntax (e.g. "/users/0/name").
pub function json_pointer_get(data, pointer: string)
    if data is null or len(pointer) == 0
        return data
    end
    if char_at(pointer, 0) != "/"
        return null
    end
    let parts = pointer.split("/")
    let curr = data
    let i = 1
    while i < len(parts)
        if curr is null
            return null
        end
        let part = _json_pointer_unescape(parts[i])
        if _jsonpath_is_int(part)
            let idx = int(part)
            let arr_len = len(curr)
            if idx >= 0 and idx < arr_len
                curr = curr[idx]
            else
                return null
            end
        else
            curr = curr[part]
        end
        i += 1
    end
    return curr
end

function _json_eval_tokens(data, tokens, start_idx)
    let curr = data
    let i = start_idx
    let tcount = len(tokens)
    while i < tcount
        if curr is null
            return null
        end
        let tok = str_from_ptr(tokens[i])
        if tok == "*"
            let res = []
            let next_idx = i + 1
            for item in curr
                if next_idx >= tcount
                    res.push(item)
                else
                    let sub_val = _json_eval_tokens(item, tokens, next_idx)
                    if sub_val is not null
                        res.push(sub_val)
                    end
                end
            end
            return res
        elif _jsonpath_is_int(tok)
            let idx = int(tok)
            let arr_len = len(curr)
            if idx < 0
                idx += arr_len
            end
            if idx >= 0 and idx < arr_len
                curr = curr[idx]
            else
                return null
            end
        else
            curr = curr[tok]
        end
        i += 1
    end
    return curr
end

## Evaluates a dot-bracket JSONPath query against a JSON structure.
pub function json_path_query(data, path: string)
    if data is null or len(path) == 0
        return data
    end
    if char_at(path, 0) == "/"
        return json_pointer_get(data, path)
    end
    let tokens = _jsonpath_split(path)
    return _json_eval_tokens(data, tokens, 0)
end

## Alias for json_path_query.
pub function json_path_get(data, path: string)
    return json_path_query(data, path)
end

## Checks if a JSONPath expression resolves to a non-null value.
##
## Presence is structural, not value-based: missing keys and
## out-of-bounds indexes fail even though untagged reads yield 0.
## Present zero/false values currently also read as absent — parsed 0,
## false, null and missing keys are mutually indistinguishable to
## predicates (see alya-lang/alya#171); that resolves itself once the
## toolchain distinguishes them.
pub function json_path_exists(data, path: string) -> bool
    if len(path) == 0
        return false
    end
    if char_at(path, 0) == "/"
        return _json_pointer_exists(data, path)
    end
    let tokens = _jsonpath_split(path)
    return _json_tokens_exist(data, tokens, 0)
end

## Structural descent for json_path_exists, mirroring _json_eval_tokens.
##
## Container checks use native `is` so parser-produced values classify
## correctly (see alya-lang/alya#171).
function _json_tokens_exist(curr, tokens, idx) -> bool
    if idx >= len(tokens)
        if curr == null
            return false
        end
        return true
    end
    let tok = str_from_ptr(tokens[idx])
    if tok == "*"
        if idx + 1 >= len(tokens)
            if curr is list
                return len(curr) > 0
            end
            if curr is map
                return len(keys(curr)) > 0
            end
            return false
        end
        if curr is list
            for item in curr
                if _json_tokens_exist(item, tokens, idx + 1)
                    return true
                end
            end
        elif curr is map
            for k in keys(curr)
                if _json_tokens_exist(curr[k], tokens, idx + 1)
                    return true
                end
            end
        end
        return false
    end
    if _jsonpath_is_int(tok)
        if curr is list
            let i = int(tok)
            let n = len(curr)
            if i < 0
                i += n
            end
            if i >= 0 and i < n
                return _json_tokens_exist(curr[i], tokens, idx + 1)
            end
        end
        return false
    end
    if curr is map
        if tok in curr
            return _json_tokens_exist(curr[tok], tokens, idx + 1)
        end
    end
    return false
end

## Structural descent for RFC 6901 pointers, mirroring json_pointer_get.
function _json_pointer_exists(data, pointer: string) -> bool
    if len(pointer) == 0
        return false
    end
    if char_at(pointer, 0) != "/"
        return false
    end
    let parts = pointer.split("/")
    let curr = data
    let i = 1
    while i < len(parts)
        let part = _json_pointer_unescape(parts[i])
        if _jsonpath_is_int(part)
            if curr is list
                let idx = int(part)
                if idx >= 0 and idx < len(curr)
                    curr = curr[idx]
                else
                    return false
                end
            else
                return false
            end
        else
            if curr is map
                if part in curr
                    curr = curr[part]
                else
                    return false
                end
            else
                return false
            end
        end
        i += 1
    end
    if curr == null
        return false
    end
    return true
end
