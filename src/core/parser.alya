## RFC 8259 Recursive-Descent JSON Parser.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./utils.alya"

function _parser_parse_string(s, pos, slen)
    pos[0] += 1
    let res = ""
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        if ch == "\""
            pos[0] += 1
            return res
        elif ch == "\\"
            pos[0] += 1
            if pos[0] < slen
                let esc = char_at(s, pos[0])
                when esc
                    is "\"" then res += "\""
                    is "\\" then res += "\\"
                    is "/"  then res += "/"
                    is "n"  then res += "\n"
                    is "r"  then res += "\r"
                    is "t"  then res += "\t"
                    is "b"  then res += chr(8)
                    is "f"  then res += chr(12)
                    is "u"  then
                        if pos[0] + 4 < slen
                            let h0 = json_hex_val(char_at(s, pos[0] + 1))
                            let h1 = json_hex_val(char_at(s, pos[0] + 2))
                            let h2 = json_hex_val(char_at(s, pos[0] + 3))
                            let h3 = json_hex_val(char_at(s, pos[0] + 4))
                            let code = h0 * 4096 + h1 * 256 + h2 * 16 + h3
                            res += chr(code)
                            pos[0] += 4
                        end
                    else
                        res += esc
                end
            end
        else
            res += ch
        end
        pos[0] += 1
    end
    return res
end

function _parser_parse_number(s, pos, slen)
    let start = pos[0]
    let is_flt = 0
    if pos[0] < slen and (char_at(s, pos[0]) == "-" or char_at(s, pos[0]) == "+")
        pos[0] += 1
    end
    while pos[0] < slen
        let ch = char_at(s, pos[0])
        let c = ord(ch)
        if c >= 48 and c <= 57
            pos[0] += 1
        else
            when ch
                is "." then
                    is_flt = 1
                    pos[0] += 1
                is "e", "E" then
                    is_flt = 1
                    pos[0] += 1
                    if pos[0] < slen and (char_at(s, pos[0]) == "+" or char_at(s, pos[0]) == "-")
                        pos[0] += 1
                    end
                else
                    break
            end
        end
    end
    if pos[0] == start
        return 0
    end
    let num_str = s[start..pos[0]]
    if is_flt == 1
        return float(num_str)
    else
        return int(num_str)
    end
end

function _parser_parse_array(s, pos, slen)
    pos[0] += 1
    let arr = []
    json_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "]"
        pos[0] += 1
        return arr
    end
    while pos[0] < slen
        let val = _parser_parse_val(s, pos, slen)
        arr.push(val)
        json_skip_ws(s, pos, slen)
        if pos[0] >= slen
            break
        end
        let ch = char_at(s, pos[0])
        if ch == ","
            pos[0] += 1
            json_skip_ws(s, pos, slen)
        elif ch == "]"
            pos[0] += 1
            break
        else
            break
        end
    end
    return arr
end

function _parser_parse_object(s, pos, slen)
    pos[0] += 1
    let obj = {}
    json_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "}"
        pos[0] += 1
        return obj
    end
    while pos[0] < slen
        json_skip_ws(s, pos, slen)
        if pos[0] >= slen or char_at(s, pos[0]) != "\""
            break
        end
        let key = _parser_parse_string(s, pos, slen)
        json_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ":"
            pos[0] += 1
        end
        let val = _parser_parse_val(s, pos, slen)
        obj[key] = val
        json_skip_ws(s, pos, slen)
        if pos[0] >= slen
            break
        end
        let ch = char_at(s, pos[0])
        if ch == ","
            pos[0] += 1
            json_skip_ws(s, pos, slen)
        elif ch == "}"
            pos[0] += 1
            break
        else
            break
        end
    end
    return obj
end

function _parser_parse_val(s, pos, slen)
    json_skip_ws(s, pos, slen)
    if pos[0] >= slen
        return null
    end
    let ch = char_at(s, pos[0])
    when ch
        is "{" then
            return _parser_parse_object(s, pos, slen)
        is "[" then
            return _parser_parse_array(s, pos, slen)
        is "\"" then
            return _parser_parse_string(s, pos, slen)
        is "t" then
            if pos[0] + 4 <= slen and substring(s, pos[0], 4) == "true"
                pos[0] += 4
                return 1
            end
            pos[0] += 1
            return 1
        is "f" then
            if pos[0] + 5 <= slen and substring(s, pos[0], 5) == "false"
                pos[0] += 5
                return 0
            end
            pos[0] += 1
            return 0
        is "n" then
            if pos[0] + 4 <= slen and substring(s, pos[0], 4) == "null"
                pos[0] += 4
                return null
            end
            pos[0] += 1
            return null
        else
            return _parser_parse_number(s, pos, slen)
    end
end

## Parses a JSON formatted string into Alya native types (Maps, Arrays, strings, numbers, booleans, null).
pub function json_parse(text)
    let s = str_from_ptr(text)
    let slen = len(s)
    if slen == 0
        return null
    end
    let pos = [0]
    return _parser_parse_val(s, pos, slen)
end

## Parses a JSON formatted string into a Map object.
pub function json_parse_object(text)
    return json_parse(text)
end

## Parses a JSON formatted string into an Array list.
pub function json_parse_array(text)
    return json_parse(text)
end

## Validates whether a string is well-formed JSON according to RFC 8259.
pub function json_is_valid(text)
    let s = str_from_ptr(text)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let pos = [0]
    json_skip_ws(s, pos, slen)
    if pos[0] >= slen
        return 0
    end
    let ch = char_at(s, pos[0])
    let c = ord(ch)
    if ch != "{" and ch != "[" and ch != "\"" and ch != "t" and ch != "f" and ch != "n" and ch != "-" and ch != "+" and (c < 48 or c > 57)
        return 0
    end
    let _res = _parser_parse_val(s, pos, slen)
    json_skip_ws(s, pos, slen)
    if pos[0] == slen
        return 1
    end
    return 0
end

## Extracts a top-level string property value by key from a raw JSON string without full parsing.
pub function json_get_string(json_str, key)
    let target = "\"" + key + "\""
    let slen = len(json_str)
    let tlen = len(target)
    let i = 0
    let pos = 0
    let start = 0
    let end_pos = 0
    let escaped = 0
    let c = ""
    while i <= slen - tlen
        if substring(json_str, i, tlen) == target
            pos = i + tlen
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t" or char_at(json_str, pos) == ":")
                if char_at(json_str, pos) == ":"
                    pos += 1
                    break
                end
                pos += 1
            end
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t")
                pos += 1
            end
            if pos < slen and char_at(json_str, pos) == "\""
                start = pos + 1
                end_pos = start
                escaped = 0
                while end_pos < slen
                    c = char_at(json_str, end_pos)
                    if escaped
                        escaped = 0
                    else
                        if c == "\\"
                            escaped = 1
                        else
                            if c == "\""
                                break
                            end
                        end
                    end
                    end_pos += 1
                end
                return json_str[start..end_pos]
            end
        end
        i += 1
    end
    return ""
end

## Extracts a top-level numeric property value by key from a raw JSON string without full parsing.
pub function json_get_number(json_str, key)
    let target = "\"" + key + "\""
    let slen = len(json_str)
    let tlen = len(target)
    let i = 0
    let pos = 0
    let num_str = ""
    let ch = ""
    let c = 0
    let is_num_char = 0
    while i <= slen - tlen
        if substring(json_str, i, tlen) == target
            pos = i + tlen
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t" or char_at(json_str, pos) == ":")
                if char_at(json_str, pos) == ":"
                    pos += 1
                    break
                end
                pos += 1
            end
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t")
                pos += 1
            end
            num_str = ""
            while pos < slen
                ch = char_at(json_str, pos)
                c = ord(ch)
                is_num_char = (c >= 48 and c <= 57) or ch == "-" or ch == "+" or ch == "."
                if is_num_char
                    num_str += ch
                else
                    break
                end
                pos += 1
            end
            if len(num_str) > 0
                let is_float_num = 0
                let ni = 0
                while ni < len(num_str)
                    if char_at(num_str, ni) == "."
                        is_float_num = 1
                        break
                    end
                    ni += 1
                end
                if is_float_num == 1
                    return float(num_str)
                else
                    return int(num_str)
                end
            end
        end
        i += 1
    end
    return 0
end

## Extracts a top-level boolean property value by key from a raw JSON string without full parsing.
pub function json_get_bool(json_str, key)
    let target = "\"" + key + "\""
    let slen = len(json_str)
    let tlen = len(target)
    let i = 0
    let pos = 0
    while i <= slen - tlen
        if substring(json_str, i, tlen) == target
            pos = i + tlen
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t" or char_at(json_str, pos) == ":")
                if char_at(json_str, pos) == ":"
                    pos += 1
                    break
                end
                pos += 1
            end
            while pos < slen and (char_at(json_str, pos) == " " or char_at(json_str, pos) == "\t")
                pos += 1
            end
            if pos + 4 <= slen and substring(json_str, pos, 4) == "true"
                return 1
            elif pos + 5 <= slen and substring(json_str, pos, 5) == "false"
                return 0
            end
        end
        i += 1
    end
    return 0
end
