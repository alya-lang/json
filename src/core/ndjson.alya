## Newline-Delimited JSON (NDJSON / JSON Lines) Streaming Module.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./utils.alya"
import "./parser.alya"
import "./serializer.alya"

## Parses newline-delimited JSON text into an array of parsed records.
pub function ndjson_parse(text)
    let s = str_from_ptr(text)
    let raw_lines = s.split("\n")
    let records = []
    for raw_line in raw_lines
        let line = json_trim(raw_line)
        if len(line) > 0
            let parsed = json_parse(line)
            if parsed is not null
                records.push(parsed)
            end
        end
    end
    return records
end

## Serializes an array of records into a newline-delimited JSON string.
pub function ndjson_stringify(records)
    if records is null or len(records) == 0
        return ""
    end
    let res = ""
    for i, item in records
        let json_line = json_stringify(item)
        if i > 0
            res += "\n"
        end
        res += json_line
    end
    return res
end

## Counts the number of non-empty NDJSON record lines in the given text.
pub function ndjson_count(text)
    let s = str_from_ptr(text)
    let raw_lines = s.split("\n")
    let total = 0
    for raw_line in raw_lines
        let line = json_trim(raw_line)
        if len(line) > 0
            total += 1
        end
    end
    return total
end
