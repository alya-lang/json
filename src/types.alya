## JSON Data Types & Model Definitions.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## JSON value type classification.
pub enum JsonType
    Null = 0,
    Bool = 1,
    Int = 2,
    Float = 3,
    String = 4,
    Array = 5,
    Object = 6
end

## Standard JSON error codes.
pub enum JsonErrorCode
    None = 0,
    UnexpectedToken = 1,
    UnexpectedEof = 2,
    InvalidNumber = 3,
    InvalidString = 4,
    InvalidUnicode = 5,
    DepthLimitExceeded = 6,
    ValidationFailed = 7
end

## Represents a single schema validation failure item.
##
## ### Fields
## - `err_path`: JSON path string where the failure occurred.
## - `err_message`: Human-readable failure message.
## - `err_keyword`: Schema keyword string (e.g. `"type"`).
pub struct ValidationError
    err_path: string,
    err_message: string,
    err_keyword: string
end

## Constructs a new ValidationError instance.
##
## ### Parameters
## - `path`: JSON path string.
## - `message`: Failure message string.
## - `keyword`: Schema keyword. Defaults to `""`.
##
## ### Returns
## The new `ValidationError` instance.
pub function make_validation_error(path: string, message: string, keyword: string = "") -> ValidationError
    return ValidationError {
        err_path: path,
        err_message: message,
        err_keyword: keyword
    }
end

## Represents the aggregated result of schema validation.
##
## ### Fields
## - `res_valid`: `1` when valid, `0` otherwise.
## - `res_errors`: `ValidationError` array.
pub struct ValidationResult
    res_valid: int,
    res_errors: array
end

## Constructs a new ValidationResult instance.
##
## ### Parameters
## - `is_valid`: Validity flag integer.
## - `errors`: `ValidationError` array. Defaults to `[]`.
##
## ### Returns
## The new `ValidationResult` instance.
pub function make_validation_result(is_valid: int, errors: array = []) -> ValidationResult
    return ValidationResult {
        res_valid: is_valid,
        res_errors: errors
    }
end

## Represents an incremental JSON document builder.
##
## ### Fields
## - `jb_data`: Accumulated container (map or array).
## - `jb_is_array`: `1` for arrays, `0` for objects.
## - `jb_json_parts`: Pre-rendered JSON fragment container.
pub struct JsonBuilder
    jb_data,
    jb_is_array: int,
    jb_json_parts
end

## Constructs a new JsonBuilder instance.
##
## ### Parameters
## - `is_array`: `1` for arrays, `0` for objects. Defaults to `0`.
##
## ### Returns
## The new `JsonBuilder` instance.
pub function make_json_builder(is_array: int = 0) -> JsonBuilder
    if is_array == 1
        return JsonBuilder {
            jb_data: [],
            jb_is_array: 1,
            jb_json_parts: []
        }
    end
    return JsonBuilder {
        jb_data: {},
        jb_is_array: 0,
        jb_json_parts: {}
    }
end
