## JSON Data Types & Model Definitions.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

## JSON value type classification.
pub enum JsonType
    Null,
    Bool,
    Int,
    Float,
    String,
    Array,
    Object
end

## Standard JSON error codes.
pub enum JsonErrorCode
    None = 0,
    UnexpectedToken = 1,
    UnexpectedEof = 2,
    InvalidNumber = 3,
    InvalidString = 4,
    InvalidUnicode = 5,
    DepthLimitExceeded = 6,
    ValidationFailed = 7
end

## Represents a single schema validation failure item.
pub struct ValidationError
    err_path,
    err_message,
    err_keyword
end

## Constructs a new ValidationError instance.
pub function make_validation_error(path, message, keyword = "")
    return ValidationError {
        err_path: path,
        err_message: message,
        err_keyword: keyword
    }
end

## Represents the aggregated result of schema validation.
pub struct ValidationResult
    res_valid,
    res_errors
end

## Constructs a new ValidationResult instance.
pub function make_validation_result(is_valid, errors = [])
    return ValidationResult {
        res_valid: is_valid,
        res_errors: errors
    }
end

## Represents an incremental JSON document builder.
pub struct JsonBuilder
    jb_data,
    jb_is_array,
    jb_json_parts
end

## Constructs a new JsonBuilder instance.
pub function make_json_builder(is_array = 0)
    if is_array == 1
        return JsonBuilder {
            jb_data: [],
            jb_is_array: 1,
            jb_json_parts: []
        }
    end
    return JsonBuilder {
        jb_data: {},
        jb_is_array: 0,
        jb_json_parts: {}
    }
end
