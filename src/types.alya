# JSON Data Types & Model Definitions
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

# Public enum for JSON types
pub enum JsonType
    Null,
    Bool,
    Int,
    Float,
    String,
    Array,
    Object
end

# Backward-compatible type constants
pub let JSON_TYPE_NULL = 0
pub let JSON_TYPE_BOOL = 1
pub let JSON_TYPE_INT = 2
pub let JSON_TYPE_FLOAT = 3
pub let JSON_TYPE_STRING = 4
pub let JSON_TYPE_ARRAY = 5
pub let JSON_TYPE_OBJECT = 6

# Getter functions for backward compatibility
pub function json_type_null()
    return JsonType.Null
end

pub function json_type_bool()
    return JsonType.Bool
end

pub function json_type_int()
    return JsonType.Int
end

pub function json_type_float()
    return JsonType.Float
end

pub function json_type_string()
    return JsonType.String
end

pub function json_type_array()
    return JsonType.Array
end

pub function json_type_object()
    return JsonType.Object
end

# Structs with distinct field prefixes to avoid cross-struct field collisions

pub struct ValidationError
    err_path,
    err_message,
    err_keyword
end

pub function make_validation_error(path, message, keyword = "")
    return ValidationError {
        err_path: path,
        err_message: message,
        err_keyword: keyword
    }
end

pub struct ValidationResult
    res_valid,
    res_errors
end

pub function make_validation_result(is_valid, errors = [])
    return ValidationResult {
        res_valid: is_valid,
        res_errors: errors
    }
end

pub struct JsonBuilder
    jb_data,
    jb_is_array,
    jb_json_parts
end

pub function make_json_builder(is_array = 0)
    let initial_data = {}
    let initial_parts = {}
    if is_array == 1
        initial_data = []
        initial_parts = []
    end
    return JsonBuilder {
        jb_data: initial_data,
        jb_is_array: is_array,
        jb_json_parts: initial_parts
    }
end
