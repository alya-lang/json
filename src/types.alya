# JSON Data Types & Model Definitions
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

pub enum JsonType
    Null,
    Bool,
    Int,
    Float,
    String,
    Array,
    Object
end

pub struct ValidationError
    err_path,
    err_message,
    err_keyword
end

pub function make_validation_error(path, message, keyword = "")
    return ValidationError {
        err_path: path,
        err_message: message,
        err_keyword: keyword
    }
end

pub struct ValidationResult
    res_valid,
    res_errors
end

pub function make_validation_result(is_valid, errors = [])
    return ValidationResult {
        res_valid: is_valid,
        res_errors: errors
    }
end

pub struct JsonBuilder
    jb_data,
    jb_is_array,
    jb_json_parts
end

pub function make_json_builder(is_array = 0)
    let initial_data = {}
    let initial_parts = {}
    if is_array == 1
        initial_data = []
        initial_parts = []
    end
    return JsonBuilder {
        jb_data: initial_data,
        jb_is_array: is_array,
        jb_json_parts: initial_parts
    }
end
