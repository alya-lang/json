# RFC 8259 JSON parser, recursive serializer, JSONPath, JSON Schema validation, and NDJSON streaming for Alya
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "./types.alya"
import "./core/utils.alya"
import "./core/parser.alya"
import "./core/serializer.alya"
import "./core/jsonpath.alya"
import "./core/schema.alya"
import "./core/ndjson.alya"
import "./core/builder.alya"

# Top-level public convenience facades

pub function parse(text)
    return json_parse(text)
end

pub function parse_object(text)
    return json_parse_object(text)
end

pub function parse_array(text)
    return json_parse_array(text)
end

pub function is_valid(text)
    return json_is_valid(text)
end

pub function stringify(val)
    return json_stringify(val)
end

pub function pretty(val, indent = 2)
    return json_pretty(val, indent)
end

pub function minify(text)
    return json_minify(text)
end

pub function query(data, path)
    return json_path_query(data, path)
end

pub function pointer(data, ptr)
    return json_pointer_get(data, ptr)
end

pub function validate(data, schema)
    return json_validate(data, schema)
end

pub function is_valid_schema(data, schema)
    return json_is_valid_schema(data, schema)
end

pub function ndjson_read(text)
    return ndjson_parse(text)
end

pub function ndjson_write(records)
    return ndjson_stringify(records)
end

pub function builder_object()
    return json_builder_object()
end

pub function builder_array()
    return json_builder_array()
end
