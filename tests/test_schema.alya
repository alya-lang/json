## Test suite for JSON Schema Validator
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/test"
import "../src/lib.alya" as json

function main()
    test_suite("JSON Schema Validator Test Suite")
    let r = runner_new()

    # Define User Schema via JSON parser
    let user_schema_json = "{\"type\":\"object\",\"required\":[\"id\",\"username\",\"age\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"username\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":20},\"age\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":120},\"role\":{\"type\":\"string\",\"enum\":[\"admin\",\"user\",\"guest\"]}},\"additionalProperties\":0}"
    let user_schema = json::parse(user_schema_json)

    # 1. Valid user object
    let valid_user = json::parse("{\"id\":101,\"username\":\"alice\",\"age\":28,\"role\":\"admin\"}")
    let res1 = json::validate(valid_user, user_schema)
    runner_assert_eq(r, res1.res_valid, 1, "valid user passes schema validation")
    runner_assert_eq(r, len(res1.res_errors), 0, "valid user has 0 errors")
    runner_assert_eq(r, json::is_valid_schema(valid_user, user_schema), 1, "is_valid_schema returns 1 for valid data")

    # 2. Missing required property
    let missing_prop_user = json::parse("{\"id\":102,\"age\":30}")
    let res2 = json::validate(missing_prop_user, user_schema)
    runner_assert_eq(r, res2.res_valid, 0, "missing required property fails validation")
    runner_assert(r, len(res2.res_errors) > 0, "errors list contains missing property error")

    # 3. Numeric minimum/maximum bound violation
    let invalid_age_user = json::parse("{\"id\":103,\"username\":\"bob\",\"age\":150,\"role\":\"user\"}")
    let res3 = json::validate(invalid_age_user, user_schema)
    runner_assert_eq(r, res3.res_valid, 0, "age > 120 fails validation")

    # 4. String length violation
    let short_name_user = json::parse("{\"id\":104,\"username\":\"al\",\"age\":25,\"role\":\"user\"}")
    let res4 = json::validate(short_name_user, user_schema)
    runner_assert_eq(r, res4.res_valid, 0, "username minLength 3 fails on length 2")

    # 5. Enum violation
    let invalid_role_user = json::parse("{\"id\":105,\"username\":\"charlie\",\"age\":35,\"role\":\"superman\"}")
    let res5 = json::validate(invalid_role_user, user_schema)
    runner_assert_eq(r, res5.res_valid, 0, "role not in enum fails validation")

    # 6. Additional properties violation
    let extra_prop_user = json::parse("{\"id\":106,\"username\":\"david\",\"age\":40,\"role\":\"guest\",\"hacker_field\":999}")
    let res6 = json::validate(extra_prop_user, user_schema)
    runner_assert_eq(r, res6.res_valid, 0, "undeclared property with additionalProperties:0 fails")

    # 7. Array schema with item validation and bounds
    let tags_schema_json = "{\"type\":\"array\",\"minItems\":1,\"maxItems\":4,\"items\":{\"type\":\"string\",\"minLength\":2}}"
    let tags_schema = json::parse(tags_schema_json)

    let valid_tags = json::parse_array("[\"dev\", \"rust\", \"alya\"]")
    let res_tags1 = json::validate(valid_tags, tags_schema)
    runner_assert_eq(r, res_tags1.res_valid, 1, "valid tags array passes")

    let empty_tags = json::parse_array("[]")
    let res_tags2 = json::validate(empty_tags, tags_schema)
    runner_assert_eq(r, res_tags2.res_valid, 0, "empty tags fails minItems 1")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
